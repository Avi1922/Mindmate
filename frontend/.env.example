# Copy this file to frontend/.env during Phase 2.
# Firebase web configuration is intended for browser use; access is protected by
# Authentication, Security Rules, API restrictions, and App Check when deployed.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
VITE_FIREBASE_APP_ID=replace-with-app-id

VITE_API_BASE_URL=http://localhost:8000/api

