rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Browser clients can only read the signed-in user's data. Writes go
    // through FastAPI after ID-token verification. The Admin SDK uses IAM and
    // bypasses these client security rules.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;

      match /{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // Deny every path outside the user-scoped tree.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
