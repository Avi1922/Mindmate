# Copy this file to backend/.env during Phase 2. Never commit backend/.env.
APP_ENV=development
APP_NAME=MindMate API
API_PREFIX=/api
FRONTEND_ORIGIN=http://localhost:5173
# Reject declared request bodies above 64 KiB before parsing them.
MAX_REQUEST_BODY_BYTES=65536

# Firebase Admin SDK credentials from Firebase Console > Project settings > Service accounts.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example-project.iam.gserviceaccount.com
# Keep the surrounding quotes. Replace line breaks with the literal characters \n.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Create this key in Google AI Studio. It must never be exposed through VITE_*.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Model names stay configurable because Gemini availability changes over time.
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TEXT_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.8-live
